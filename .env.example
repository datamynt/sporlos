# Kopier til .env og fyll inn. .env er gitignored.
# Domenet som peker på VPS-en (Caddy henter Let's Encrypt-sert automatisk).
SPORLOS_DOMAIN=analytics.example.no
# Server-side hemmelighet for daglig-salt (generer: openssl rand -hex 32). ALDRI dev-default i prod.
SPORLOS_SALT_SECRET=change-me-openssl-rand-hex-32
# Postgres-passord (brukes av både db og app via DATABASE_URL i compose).
POSTGRES_PASSWORD=change-me-strong-password
# Session-secret for innlogging (openssl rand -hex 32).
SPORLOS_SESSION_SECRET=change-me-openssl-rand-hex-32
# E-post (PÅKREVD i prod — passord-reset/verifisering feiler ellers stille).
# Relay-mønster: SMTP_HOST + MAIL_FROM holder; SMTP_USER/PASS valgfritt v/ login-relay.
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=post@analytics.example.no
# Hvor drifts-varsler (stille-stopp) sendes. Tomt = faller tilbake til MAIL_FROM.
SPORLOS_ADMIN_EMAIL=
# Google OAuth (valgfritt — "Logg inn med Google"). Tomt = funksjonen skjult.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe (valgfritt — kort-betaling). Tomt = "Oppgrader"-knapper skjult.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITEN=
STRIPE_PRICE_VEKST=
STRIPE_PRICE_PRO=

# Vipps MobilePay (valgfritt — abonnement via Recurring API). Tomt = Vipps-knapper skjult.
# Mode-bevisst som Stripe: VIPPS_MODE velger _TEST/_LIVE-suffiksede varianter.
VIPPS_MODE=test
VIPPS_MSN_TEST=
VIPPS_MSN_LIVE=
VIPPS_CLIENT_ID_TEST=
VIPPS_CLIENT_SECRET_TEST=
VIPPS_SUBSCRIPTION_KEY_TEST=
VIPPS_CLIENT_ID_LIVE=
VIPPS_CLIENT_SECRET_LIVE=
VIPPS_SUBSCRIPTION_KEY_LIVE=

# Nettside-assistent (valgfritt — chat-widget). Tomt = ingen widget, /api/assist 503.
LLM_GATEWAY_URL=https://llm.peck.to
LLM_GATEWAY_API_KEY=
ASSIST_MODEL=gemini-3.1-flash-lite
